rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check teacher claim (STRICT: no email != null fallback)
    function isTeacher() {
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role == 'teacher' || request.auth.token.role == 'TEACHER')) ||
        ('teacher' in request.auth.token && request.auth.token.teacher == true)
      );
    }
    
    // Helper function to check admin claim
    function isAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && (request.auth.token.role == 'admin' || request.auth.token.role == 'ADMIN')) ||
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    // Helper function to check if authenticated as specific student (Verified Custom Claim strictly)
    function isOwningStudent(studentId) {
      return isAuthenticated() && (
        'student_id' in request.auth.token && 
        (request.auth.token.student_id == studentId ||
         string(request.auth.token.student_id) == string(studentId) ||
         'student_user' + string(request.auth.token.student_id) == string(studentId) ||
         'student_' + string(request.auth.token.student_id) == string(studentId) ||
         'user' + string(request.auth.token.student_id) == string(studentId))
      );
    }

    // Helper function to check session ownership (sessionId format: session_{num}_student_{studentId})
    function isOwningSession(sessionId) {
      return isAuthenticated() && (
        'student_id' in request.auth.token &&
        sessionId.matches('.*_student_' + string(request.auth.token.student_id) + '($|_.*)')
      );
    }

    // Teacher class match check
    function isTeacherOfClass(classId) {
      return isTeacher() && (
        !('class_id' in request.auth.token) || 
        request.auth.token.class_id == null || 
        request.auth.token.class_id == classId || 
        isAdmin()
      );
    }

    // The class teacher, and not the admin: a document of her class, or a
    // document that does not exist (a get of a missing record).
    function isClassTeacherReading() {
      return isTeacher() && !isAdmin() &&
        (resource == null || isTeacherOfClass(resource.data.get('class_id', null)));
    }

    // --- Strict Allowlist Schemas (Replacing Negative PII Blocklists) ---

    // 1. Anonymous Student Schema Allowlist (Module 4 & Appendix A §1)
    function isValidStudentDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'student_id',
        'class_id',
        'school_id',
        'created_at',
        'support_profile_id',
        'support_profile_version',
        'support_profile_updated_at',
        'support_profile_updated_by',
        'active_session_id'
      ]) &&
      data.student_id is int && data.student_id >= 1 && data.student_id <= 12 &&
      data.class_id is string &&
      data.school_id is string &&
      data.created_at is number &&
      // הגרסה נבדקת כשהיא קיימת. הדרישה שתהיה תמיד חסמה את מסמכי התלמידים
      // כולם: המורה יוצרת אותם בהפעלת מפגש בלי השדה הזה (בכוונה — מודול 19
      // מנהל אותו, וכתיבת ערך קבוע בכל הפעלה הייתה מאפסת פרופיל מותאם),
      // ולכן כל יצירה נדחתה והאוסף נשאר ריק. הדוח הפדגוגי ומצבור הניהול
      // קוראים בדיוק את המסמכים האלה.
      (!('support_profile_version' in data) || data.support_profile_version is int);
    }

    // מודול 19 §ב: "Only authorized teachers may write this field". פרופיל
    // התמיכה הוא החלטה שקטה של המורה, והדוח הפדגוגי קורא אותו מהמסמך הזה.
    function supportProfileKeys() {
      return [
        'support_profile_id',
        'support_profile_version',
        'support_profile_updated_at',
        'support_profile_updated_by'
      ];
    }

    function writerMayTouchSupportProfileOnCreate() {
      return isTeacher() || !request.resource.data.keys().hasAny(supportProfileKeys());
    }

    function writerMayTouchSupportProfileOnUpdate() {
      return isTeacher() ||
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(supportProfileKeys());
    }

    // 2. Telemetry Log Schema Allowlist (Module 5 & Appendix A §3)
    function isColumnScopedEvent(eventType) {
      return eventType in [
        'BLOCK_DRAG_COMPLETE',
        'REGROUPING_TRIGGERED',
        'REGROUPING_SUCCESS',
        'DIGIT_ENTERED',
        'DIGIT_DELETED',
        'HESITATION_DETECTED',
        'SOCRATIC_CARD_SHOWN',
        // Register, deviation 19 (owner, 16.9.2026): the scaffold events. They were
        // added to the client's lists only, so every one of them was refused here,
        // retried five times and parked on the learner's device; the class report's
        // grid / keyboard-lock / help counters stayed at zero.
        'KEYBOARD_LOCK_BLOCKED'
      ];
    }

    function isNonColumnEvent(eventType) {
      return eventType in [
        'SESSION_START',
        'PROBLEM_LOAD',
        'SOCRATIC_OPTION_SELECTED',
        'PROBLEM_COMPLETE',
        'REFLECTION_SUBMITTED',
        // Register, deviation 19 — see isColumnScopedEvent.
        'ADAPTIVE_GRID_TOGGLED',
        'HELP_REQUESTED',
        // Module 8 §א: clearing the whole board with the trash button. It
        // belongs to no single column — it empties all of them.
        'BOARD_CLEARED',
        // Register deviation 28 (owner, 30.9.2026): the place-cue scaffold of
        // the result row — the whole row, not one column.
        'PLACE_CUES_SHOWN',
        // Owner, 30.9.2026: the learner took the silent help call back.
        // Research data only; it belongs to no column.
        'HELP_WITHDRAWN',
        // Owner, 1.10.2026: a request for help from the chat, with its exercise.
        'CHAT_HELP_REQUESTED',
        // PRD Module 5 §ג / Appendix A §3: the branch choice after the 7
        // compulsory exercises (Module 14 §ג); it belongs to no column.
        'BRANCH_SELECTED'
      ];
    }

    function isValidTelemetryDoc() {
      let data = request.resource.data;
      let hasPermittedKeys = data.keys().hasOnly([
        'idempotency_key',
        'client_timestamp',
        'session_id',
        'student_id',
        'exercise_id',
        'event_type',
        'column_index',
        'details',
        'synced_at',
        // PRD Module 5 §ב / Appendix A §3: the server's time of receipt, the
        // device's per-sign-in counter and the browser's random id.
        'server_received_at',
        'sequence_number',
        'device_id'
      ]);

      let validTypes = data.idempotency_key is string &&
                       // Module 4 / Module 17 §ב / Appendix A §3: synced_at, the device's
                       // time when the queue sent the event, is required. The queue stamps
                       // it on every delivery (telemetryDocumentOf), so an event queued
                       // before the field existed carries it too.
                       ('synced_at' in data) && data.synced_at is number &&
                       data.client_timestamp is number &&
                       data.session_id is string &&
                       data.student_id is int && data.student_id >= 1 && data.student_id <= 12 &&
                       data.exercise_id is string &&
                       data.event_type is string &&
                       data.details is map &&
                       // Appendix A §3: set by the server (serverTimestamp), equal to request.time.
                       ('server_received_at' in data) && data.server_received_at == request.time &&
                       // Module 5 §ב: the browser's random id. The queue stamps it on delivery,
                       // so an event queued before it existed carries it too.
                       ('device_id' in data) && data.device_id is string && data.device_id.matches('^[A-Za-z0-9_-]{8,64}$') &&
                       // Absent only on an event queued before the counter existed: it cannot be
                       // invented afterwards, and a refused event is never discarded (Module 17 §ב).
                       (!('sequence_number' in data) || (data.sequence_number is int && data.sequence_number >= 0));

      let validColumnRule = (isColumnScopedEvent(data.event_type) && ('column_index' in data) && data.column_index in [0, 1, 2, 3]) ||
                            (isNonColumnEvent(data.event_type) && (!('column_index' in data) || data.column_index == null)) ||
                            (data.event_type == 'UNDO_EXECUTED');

      let validDigitEntered = (data.event_type != 'DIGIT_ENTERED') ||
                              (!('is_correct' in data.details) || data.details.is_correct is bool || data.details.is_correct == null);

      return hasPermittedKeys && validTypes && validColumnRule && validDigitEntered;
    }

    // 3. Session Document Schema Allowlist (Module 14 / Appendix A §2)
    function isValidSessionDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'session_id',
        'class_id',
        'session_number',
        'session_start_time',
        'session_deadline_time',
        'active_exercise_id',
        'is_completed',
        'session_score_percent',
        'teacher_gate_approved',
        'gate_approved_at',
        'gate_approved_by',
        'teacher_selected_path',
        'matrix_recommended_path',
        'evaluated_at',
        // PRD 14 §ב0: the score before the learner's latest completion, kept
        // beside the new one (sessionTrigger.ts, Admin SDK). Server-only below.
        'previous_score_percent',
        'pedagogical_report_pdf_path',
        'pedagogical_report_generated_at'
      ]) &&
      data.session_id is string &&
      data.class_id is string &&
      data.session_number is int && data.session_number >= 1 && data.session_number <= 8 &&
      data.is_completed is bool &&
      data.teacher_gate_approved is bool;
    }

    // מודול 20: המסלול שהמורה בחרה וחותמות האישור הן החלטה שלה, והציון
    // וההמלצה מחושבים "בטריגר עצמאי על סיום המפגש" (sessionTrigger.ts, Admin
    // SDK — החוקים אינם חלים עליו). לומד אינו קובע אותם, אינו משנה אותם ואינו
    // מרוקן אותם. הכלל הקודם בדק רק את המצב שאחרי הכתיבה, ולכן לומד יכול היה
    // למחוק אישור שכבר ניתן ולשנות ציון שהשרת כבר חישב (בעל המוצר, 29.9.2026).
    // ערך חסר ו-null הם אותו דבר: createSessionWithServerDeadline יוצר את
    // השדות כ-null, ומסמכים ישנים חסרים אותם.
    function learnerCreateLeavesStaffFieldsEmpty() {
      let d = request.resource.data;
      return d.get('teacher_selected_path', null) == null &&
             d.get('gate_approved_at', null) == null &&
             d.get('gate_approved_by', null) == null &&
             d.get('session_score_percent', null) == null &&
             d.get('matrix_recommended_path', null) == null &&
             d.get('evaluated_at', null) == null &&
             d.get('previous_score_percent', null) == null;
    }

    function sessionFieldUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // PRD 14 §ב0 / 23 §ב: the score, the recommendation it gives, the
    // server's evaluation stamp and the score kept from before the latest
    // completion are computed by the server alone (sessionTrigger.ts, Admin
    // SDK). No client token writes them — the teacher's included: the teacher
    // client writes only the four approval fields (teacherGate.ts).
    function createLeavesServerScoreFieldsEmpty() {
      let d = request.resource.data;
      return d.get('session_score_percent', null) == null &&
             d.get('matrix_recommended_path', null) == null &&
             d.get('evaluated_at', null) == null &&
             d.get('previous_score_percent', null) == null;
    }

    function updateKeepsServerScoreFields() {
      return sessionFieldUnchanged('session_score_percent') &&
             sessionFieldUnchanged('matrix_recommended_path') &&
             sessionFieldUnchanged('evaluated_at') &&
             sessionFieldUnchanged('previous_score_percent');
    }

    function learnerUpdateKeepsStaffFields() {
      return sessionFieldUnchanged('teacher_selected_path') &&
             sessionFieldUnchanged('gate_approved_at') &&
             sessionFieldUnchanged('gate_approved_by') &&
             sessionFieldUnchanged('session_score_percent') &&
             sessionFieldUnchanged('matrix_recommended_path') &&
             sessionFieldUnchanged('evaluated_at') &&
             sessionFieldUnchanged('previous_score_percent');
    }

    // --- Collections Routing ---

    // Students Collection: Strict Ownership & Teacher Class Guard (Direct read denied for Admin, allowed for Teacher and owning Student)
    // Module 27 §ב.4: a learner writes only to telemetry_logs and workspace_states
    // ("Block student role auth tokens from writing … students collections").
    // Nothing on the learner's side writes here: the documents are created by
    // the teacher's meeting activation (TeacherDashboard) and by the Admin SDK.
    // A learner token could still create up to four documents for itself, with
    // any student_id, and adminAggregator counts this collection as total_students.
    match /students/{studentId} {
      allow read: if (isTeacher() || isOwningStudent(studentId)) && !isAdmin();
      allow create: if isTeacher() && isValidStudentDoc() &&
                       writerMayTouchSupportProfileOnCreate();
      allow update: if isTeacher() && isValidStudentDoc() &&
                       writerMayTouchSupportProfileOnUpdate();
      // Module 23א §ו: deleting learning data is a reset, and the admin is
      // blocked from resets. Resets run in backupAndResetSessionData (Admin SDK).
      allow delete: if false;
    }

    match /users/students/{studentId} {
      allow read: if (isTeacher() || isOwningStudent(studentId)) && !isAdmin();
      allow create: if isTeacher() && isValidStudentDoc() &&
                       writerMayTouchSupportProfileOnCreate();
      allow update: if isTeacher() && isValidStudentDoc() &&
                       writerMayTouchSupportProfileOnUpdate();
      // Module 23א §ו: deleting learning data is a reset, and the admin is
      // blocked from resets. Resets run in backupAndResetSessionData (Admin SDK).
      allow delete: if false;
    }

    // Sessions Collection: Students can create/update their OWN session, but ONLY teachers can approve teacher_gate_approved
    // Module 24 §ב: a learner's session document is a personal document — no admin read.
    match /sessions/{sessionId} {
      allow read: if isTeacher() || isOwningSession(sessionId);
      allow create: if (isTeacher() || isOwningSession(sessionId)) && isValidSessionDoc() &&
                       // Module 4: the client writes a session document for meeting 2 only.
                       (isTeacher() || request.resource.data.session_number == 2) &&
                       (isTeacher() || request.resource.data.teacher_gate_approved == false) &&
                       (isTeacher() || learnerCreateLeavesStaffFieldsEmpty()) &&
                       createLeavesServerScoreFieldsEmpty();
      allow update: if (isTeacher() || isOwningSession(sessionId)) && isValidSessionDoc() &&
                       (isTeacher() || request.resource.data.teacher_gate_approved == resource.data.teacher_gate_approved) &&
                       (isTeacher() || learnerUpdateKeepsStaffFields()) &&
                       updateKeepsServerScoreFields();
      allow delete: if false; // Module 23א §ו — see students
    }

    // Telemetry Logs: Strictly Owning Student or Teacher; Idempotency Doc ID; Schema Allowlist (Direct read denied for Admin)
    match /telemetry_logs/{logId} {
      // Module 24 blocks system admins from individual telemetry. A dual identity
      // (teacher + admin) reads as the teacher; only an admin-only identity is blocked.
      allow read: if isTeacher() || (isOwningStudent(string(resource.data.student_id)) && !isAdmin());
      allow create: if isAuthenticated() &&
                       (isOwningStudent(string(request.resource.data.student_id))) &&
                       (request.resource.data.idempotency_key == logId) &&
                       // Module 4: the document id is the event's idempotency_key, a UUID v4.
                       logId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') &&
                       isValidTelemetryDoc();
      allow update: if false;
      allow delete: if false; // Module 23א §ו — see students
    }

    // Authorized Teachers / Whitelist (Module 25)
    //
    // The document id IS an institutional email address, and the collection
    // was readable by every signed-in identity — a learner token could list
    // every teacher in the pilot by name. Module 27 §ב.4 gives a student
    // read access to their own document and nothing else, and architecture
    // invariant 1 (Zero-PII) makes an email the one thing that must never
    // reach a learner. Staff read it; anyone else reads only the document
    // that IS their own address, which is what the login check
    // (AuthService.isWhitelistedTeacherEmailAsync) asks for: at that moment
    // the Google identity exists but the role claim has not been stamped yet.
    match /authorizedTeachers/{email} {
      allow read: if isTeacher() || isAdmin() ||
                     (isAuthenticated() && 'email' in request.auth.token &&
                      request.auth.token.email is string &&
                      email == request.auth.token.email.lower());
      allow write: if isAdmin();
    }

    // 4. Class Document Schema Allowlist (Module 4 / Module 25)
    function isValidClassDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'class_id',
        'school_id',
        'class_name',
        'class_type',
        'teacher_id',
        'active_session_id',
        'projector_mode',
        'projector_mode_updated_at',
        'student_count',
        'students',
        'updated_by_teacher_id',
        'created_at'
      ]) &&
      data.class_id is string && data.class_id.size() > 0 &&
      data.school_id is string && data.school_id.size() > 0 &&
      data.class_name == 'המבקרים' &&
      data.class_type is string && data.class_type.size() > 0 &&
      (!('student_count' in data) || (data.student_count is int && data.student_count >= 0 && data.student_count <= 12));
    }

    // Classes & Schools Collections
    // Module 25 §ב.1: one school (school_bikorot) and one class (class_1).
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && schoolId == 'school_bikorot';
      allow delete: if isAdmin();
    }

    // Module 27 §ב.4: a learner is "חסום מקריאת אוספי כיתות או תלמידים
    // אחרים", and the strict instructions say the same — "Block student role
    // auth tokens from … reading classes and students collections". Only the
    // teacher dashboard reads this document; the learner's own lobby follows
    // the RTDB class-session broadcast and never touches it.
    match /classes/{classId} {
      allow read: if isTeacher() || isAdmin();
      allow create, update: if classId == 'class_1' && (isTeacherOfClass(classId) || isAdmin()) && isValidClassDoc();
      allow delete: if isAdmin();
    }

    // Teacher-Admin Messages (Module 22: Direct client create is BLOCKED; writes permitted exclusively via sendTeacherAdminMessage Cloud Function)
    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.sender_id ||
                      request.auth.uid == resource.data.receiver_id ||
                      isAdmin() || isTeacher());
      allow create: if false;
      allow update: if isAuthenticated() &&
                       (request.auth.uid == resource.data.receiver_id || isAdmin() || isTeacher()) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // Admin Cached Store (Module 24: Store Cache)
    // "a read-only cache store": only the server computes it (adminAggregator,
    // aiMonitoring, the reset's recompute — all Admin SDK). No client writes it;
    // an admin token could overwrite the figures the console shows as the server's.
    // Module 24 §ב: "הריצה משרתת את מנהל המערכת בלבד; המורה והלומדים אינם
    // קוראים ממסמך זה." Admin only.
    match /store_cache/{cacheId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Workspace States & Radar Logs
    // Module 24 §ב: a learner's board and the radar's per-learner alerts are
    // individual data — the teacher's and the learner's, not the admin's.
    match /workspace_states/{stateId} {
      allow read: if isTeacher() || isOwningStudent(string(resource.data.student_id));
      allow create, update: if (isTeacher() || isOwningStudent(string(request.resource.data.student_id))) &&
                               request.resource.data.keys().hasOnly([
                                 'student_id', 'session_id', 'exercise_id', 'active_column_index', 'ones_count', 'tens_count', 'hundreds_count', 'memory_circles', 'updated_at'
                               ]);
      allow delete: if false; // Module 23א §ו — see students
    }

    match /radar_alerts/{alertId} {
      allow read: if isTeacher();
      allow write: if false; // no client writes these; per-learner alerts are not the admin's
    }

    match /audit_logs/{logId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // Reset Audit Logs (Module 23א: Immutable Audit Log for All Data Resets & Dataset Exports)
    match /reset_audit_log/{logId} {
      // Module 23א §ו: "יומן האיפוסים נקרא על ידי המורה של הכיתה בלבד; מנהל
      // המערכת אינו קורא אותו." A query must name the class (class_id ==).
      allow read: if isClassTeacherReading();
      // Module 23א: the reset flow writes its own entry, in the Cloud Function
      // (backupAndResetSessionData, Admin SDK). No client writes here. A direct
      // teacher create had no schema, could never be deleted, and was read back
      // by the research export and by the first-attempt score (meetingMetrics
      // lastResetOfMeeting) as if a real reset had happened.
      allow create: if false;
      allow update, delete: if false; // Strict requirement: log is immutable and cannot be deleted
    }

    // SRL Reflections (Module 16 — Session 8 Reflection)
    // Only the owning student may write their own reflection document.
    // Schema is strictly enforced: no extra fields, no cross-student writes, create-only.
    function isValidSRLReflectionDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'student_id',
        'session_id',
        'session_number',
        'effort_level',
        'selected_strategies',
        'persistence_index',
        'undo_count',
        'error_count',
        'guess_count',
        'submitted_at'
      ]) &&
      data.student_id is int && data.student_id >= 1 && data.student_id <= 12 &&
      data.session_id is string &&
      data.session_number is int && data.session_number == 8 &&
      data.effort_level in ['LOW', 'MEDIUM', 'HIGH'] &&
      data.selected_strategies is list &&
      data.persistence_index is number && data.persistence_index >= 0 && data.persistence_index <= 100 &&
      data.submitted_at is number;
    }

    // Support Tickets (Module 28: Admin Support Hub)
    function isValidSupportTicketDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'school_id',
        'school_name',
        'class_id',
        'class_name',
        'student_id',
        'teacher_id',
        'subject',
        'category',
        'priority',
        'status',
        'description',
        'created_at',
        'updated_at',
        'responses'
      ]) &&
      data.school_id is string &&
      data.class_id is string &&
      data.subject is string &&
      data.category in ['PEDAGOGICAL', 'TECHNICAL', 'ACCOMMODATION_ASD', 'GENERAL'] &&
      data.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT'] &&
      data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
      data.description is string;
    }

    match /support_tickets/{ticketId} {
      allow read: if isTeacher() || isAdmin();
      allow create, update: if (isTeacher() || isAdmin()) && isValidSupportTicketDoc();
      allow delete: if isAdmin();
    }

    // System Control (Module 26: Curriculum & Batch Distribution)
    match /system_control/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Curriculum Catalog (Module 4 & Module 26: Canonical Exercise Templates)
    match /curriculum_catalog/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /srl_reflections/{reflectionId} {
      allow read: if isTeacher() || isOwningStudent(string(resource.data.student_id));
      allow create: if isOwningStudent(string(request.resource.data.student_id)) &&
                       isValidSRLReflectionDoc();
      allow update: if false;
      allow delete: if false; // Module 23א §ו — see students
    }

    // Pedagogical Reports (Module 23 & 27: Strict Class-Scoped Read-Only Access)
    match /reports/{reportId} {
      // A document that does not exist has no resource.data, so a teacher's get
      // of a report not produced yet was DENIED — and the dashboard had to treat
      // every denial as "no report yet". A teacher whose claims were missing then
      // saw "עדיין לא הופק דוח" for ever, with nothing to say access was the problem.
      allow get: if isTeacher() && (resource == null || isTeacherOfClass(resource.data.class_id));
      allow list: if isTeacherOfClass(resource.data.class_id);
      allow write: if false; // Writes restricted strictly to Cloud Functions Admin SDK
    }

    // Catch-up time (owner, 2.10.2026): "המורה יקח את אותם ילדים שלא סיימו
    // למפגש נוסף \ זמן נוסף וזה יתועד מה הסיבה לכך". One document per learner
    // × meeting, id = the session document's spelling (session_0N_student_K).
    // The teacher records why a learner did not finish: she creates the
    // document or adds exactly ONE new round per write, and never changes or
    // removes a round already there. The server (catchUpRounds.ts, Admin SDK)
    // fills opened_at / closed_at / closed_by / active_minutes, so the teacher
    // writes them as null. Learners: no read, no write. Admin: read only.
    function catchUpReasonKeys() {
      return ['slow_pace', 'partial_absence', 'technical_fault', 'content_difficulty', 'other'];
    }

    function isValidCatchUpRound(round) {
      return round is map &&
             round.keys().hasOnly([
               'action', 'reason', 'note', 'stopped_at', 'recorded_by', 'recorded_at',
               'opened_at', 'closed_at', 'closed_by', 'active_minutes'
             ]) &&
             round.keys().hasAll([
               'action', 'reason', 'note', 'stopped_at', 'recorded_by', 'recorded_at',
               'opened_at', 'closed_at', 'closed_by', 'active_minutes'
             ]) &&
             round.action in ['reopen', 'continue'] &&
             round.reason in catchUpReasonKeys() &&
             (round.note == null || (round.note is string && round.note.size() <= 300)) &&
             (round.stopped_at == null || (round.stopped_at is string && round.stopped_at.size() <= 120)) &&
             round.recorded_by == request.auth.uid &&
             round.recorded_at is number &&
             round.opened_at == null &&
             round.closed_at == null &&
             round.closed_by == null &&
             round.active_minutes == null;
    }

    function isValidCatchUpDoc(docId) {
      let d = request.resource.data;
      // The score fields are the server's (sessionTrigger.ts, PRD 14 §ב0): the
      // score at the completion, the one before it, and the score when the
      // catch-up round opened. A teacher never writes them (create below, and
      // an update may change only `rounds`).
      return d.keys().hasOnly(['student_id', 'session_number', 'class_id', 'rounds',
                               'score_percent', 'previous_score_percent', 'scored_at',
                               'score_before_catchup_percent', 'score_before_catchup_at']) &&
             d.student_id is int && d.student_id >= 1 && d.student_id <= 12 &&
             d.session_number is int && d.session_number >= 1 && d.session_number <= 8 &&
             d.class_id is string &&
             d.rounds is map &&
             docId == 'session_0' + string(d.session_number) + '_student_' + string(d.student_id);
    }

    match /catchup_records/{docId} {
      // Readable by the class teacher only (as reset_audit_log). A missing
      // document reads as nothing rather than as a refusal.
      allow read: if isClassTeacherReading();
      allow create: if isTeacherOfClass(request.resource.data.class_id) &&
                       isValidCatchUpDoc(docId) &&
                       request.resource.data.keys().hasOnly(['student_id', 'session_number', 'class_id', 'rounds']) &&
                       request.resource.data.rounds.keys().size() == 1 &&
                       request.resource.data.rounds.keys()[0].matches('r_[0-9]+') &&
                       isValidCatchUpRound(request.resource.data.rounds[request.resource.data.rounds.keys()[0]]);
      allow update: if isTeacherOfClass(resource.data.class_id) &&
                       isValidCatchUpDoc(docId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rounds']) &&
                       request.resource.data.rounds.diff(resource.data.rounds).removedKeys().size() == 0 &&
                       request.resource.data.rounds.diff(resource.data.rounds).changedKeys().size() == 0 &&
                       request.resource.data.rounds.diff(resource.data.rounds).addedKeys().size() == 1 &&
                       request.resource.data.rounds.keys().removeAll(resource.data.rounds.keys())[0].matches('r_[0-9]+') &&
                       isValidCatchUpRound(request.resource.data.rounds[request.resource.data.rounds.keys().removeAll(resource.data.rounds.keys())[0]]);
      // Module 23א §ו: deleting learning data is a reset (backupAndResetSessionData, Admin SDK).
      allow delete: if false;
    }

    // Module 23 — the class report of one meeting (generateClassMeetingReport).
    match /class_reports/{reportId} {
      allow get: if isTeacher() && (resource == null || isTeacherOfClass(resource.data.class_id));
      allow list: if isTeacherOfClass(resource.data.class_id);
      allow write: if false; // Writes restricted strictly to Cloud Functions Admin SDK
    }

    // Modules 1 §א and 25 §ב.3 — the learners' personal access codes. Closed to
    // every client, staff included: the teacher and the admin read and change
    // them only through getLearnerAccessCodes / regenerateLearnerAccessCode.
    match /learner_access_codes/{classId} {
      allow read, write: if false;
    }
  }
}
