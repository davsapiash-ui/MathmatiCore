// Empty paragraphs to remove (the two blank lines before "כיווני החקירה" in theme 5).
var DELETE_EMPTY = [74, 75];

function createSuggestionsCopy() {
  var source = DocumentApp.getActiveDocument();
  var paragraphs = source.getBody().getParagraphs();

  // Check first: every paragraph to change must still read exactly as when the suggestions were made.
  var stale = [];
  CHANGES.forEach(function (c) {
    var p = paragraphs[c[0]];
    if (!p || p.getText() !== c[1]) stale.push(c[0] + 1);
  });
  DELETE_EMPTY.forEach(function (i) {
    if (!paragraphs[i] || paragraphs[i].getText() !== '') stale.push(i + 1);
  });
  if (stale.length) {
    throw new Error('המסמך השתנה מאז שההצעות הוכנו (פסקאות ' + stale.join(', ') + '). לא נוצר עותק.');
  }

  var copyFile = DriveApp.getFileById(source.getId()).makeCopy(source.getName() + ' — הצעות תיקון');
  var copy = DocumentApp.openById(copyFile.getId());
  var copyParagraphs = copy.getBody().getParagraphs();

  CHANGES.forEach(function (c) {
    var text = copyParagraphs[c[0]].editAsText();
    var ops = c[3];
    for (var k = ops.length - 1; k >= 0; k--) {
      var from = ops[k][0], to = ops[k][1], insert = ops[k][2];
      if (to > from) text.deleteText(from, to - 1);
      if (insert) {
        if (from >= text.getText().length) text.appendText(insert);
        else text.insertText(from, insert);
      }
    }
    if (text.getText() !== c[2]) throw new Error('פסקה ' + (c[0] + 1) + ' לא תוקנה כמצופה.');
  });
  for (var d = DELETE_EMPTY.length - 1; d >= 0; d--) copyParagraphs[DELETE_EMPTY[d]].removeFromParent();
  copy.saveAndClose();

  Logger.log('נוצר עותק עם ' + CHANGES.length + ' פסקאות מתוקנות:\n' + copyFile.getUrl() +
    '\n\nעכשיו במסמך המקורי: כלים ← השוואת מסמכים ← בחר את העותק.');
}
