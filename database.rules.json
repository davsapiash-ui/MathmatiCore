        }
      },
      "teachers": {
        ".read": "auth != null",
        "$teacherId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "students": {
      ".read": "auth != null",
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "radar_alerts": {
      ".read": "auth != null",
      "$alertId": {
        ".write": "auth != null"
      }
    },

    "reflections": {
      ".read": "auth != null",
      "$reflectionId": {
        ".write": "auth != null"
      }
    },

    "chat_messages": {
      ".read": "auth != null",
