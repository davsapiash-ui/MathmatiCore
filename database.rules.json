{
  "rules": {
    "schools": {
      ".read": true,
      ".write": "auth != null"
    },
    "public_classes": {
      ".read": true,
      ".write": "auth != null"
    },
    "classes": {
      ".read": true,
      ".write": "auth != null"
    },
    "users": {
      "students": {
        ".read": "auth != null",
        "$studentId": {
          ".read": "auth != null && (auth.token.role == 'teacher' || auth.token.role == 'TEACHER' || auth.token.email == $studentId + '@mathmaticore.local' || auth.uid == $studentId)",
          ".write": "auth != null && ($studentId.matches(/^student_(user)?(1[0-2]|[1-9])$/) || $studentId.matches(/^(1[0-2]|[1-9])$/)) && (auth.token.role == 'teacher' || auth.token.role == 'TEACHER' || auth.token.email == $studentId + '@mathmaticore.local' || auth.uid == $studentId)"
        }
      },
      "teachers": {
        ".read": true,
        "$teacherId": {
          ".read": true,
          ".write": "auth != null && (data.exists() || newData.child('licenseActive').val() === false)",
          "licenseActive": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "students": {
      ".read": "auth != null",
      "$studentId": {
        ".read": "auth != null && (auth.token.role == 'teacher' || auth.token.role == 'TEACHER' || auth.token.email == $studentId + '@mathmaticore.local' || auth.uid == $studentId)",
        ".write": "auth != null && ($studentId.matches(/^student_(user)?(1[0-2]|[1-9])$/) || $studentId.matches(/^(1[0-2]|[1-9])$/)) && (auth.token.role == 'teacher' || auth.token.role == 'TEACHER' || auth.token.email == $studentId + '@mathmaticore.local' || auth.uid == $studentId)"
      }
    },
    "radar_alerts": {
      ".read": true,
      ".write": "auth != null"
    },
    "reflections": {
      ".read": true,
      ".write": "auth != null"
    },
    "chat_messages": {
      ".read": "auth != null && auth.token.email != null",
      "$roomId": {
        ".read": "auth != null && (auth.uid == $roomId || auth.token.email != null)",
        ".write": "auth != null && (auth.uid == $roomId || auth.token.email != null)"
      }
    },
    "sessions": {
      ".read": true,
      ".write": "auth != null"
    },
    "replays": {
      ".read": true,
      ".write": "auth != null"
    },
    "approved_tasks": {
      ".read": true,
      ".write": "auth != null"
    },
    "ai_pending_approvals": {
      ".read": true,
      ".write": "auth != null"
    },
    "system_control": {
      ".read": true,
      ".write": "auth != null"
    },
    "active_class_session": {
      ".read": true,
      ".write": "auth != null"
    },
    "audit_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    }
  }
}
