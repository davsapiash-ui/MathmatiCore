{
  "rules": {
    "schools": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'ADMIN')"
    },
    "public_classes": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'ADMIN')"
    },
    "classes": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'ADMIN' || auth.token.role == 'teacher' || auth.token.role == 'TEACHER')"
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "students": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$studentId": {
          ".read": "auth != null",
          ".write": "auth != null && ($studentId.matches(/^student_(user)?(1[0-2]|[1-9])$/) || $studentId.matches(/^(1[0-2]|[1-9])$/))"
        }
      },
      "teachers": {
        ".read": "auth != null",
        "$teacherId": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'ADMIN' || (auth.token.email != null && auth.token.email.matches(/.*admin.*/)) || auth.uid == $teacherId)",
          "licenseActive": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "students": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null && ($studentId.matches(/^student_(user)?(1[0-2]|[1-9])$/) || $studentId.matches(/^(1[0-2]|[1-9])$/))"
      }
    },
    "radar_alerts": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$alertId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "!newData.child('studentName').exists() && !newData.child('name').exists() && !newData.child('email').exists() && !newData.child('taz').exists() && !newData.child('rawStudentName').exists()"
      }
    },
    "chat_messages": {
      ".read": "auth != null && (auth.token.role == 'teacher' || auth.token.role == 'admin')",
      ".write": "auth != null",
      "$roomId": {
        ".read": "auth != null && (auth.uid == $roomId || auth.token.role == 'teacher' || auth.token.role == 'admin')",
        ".write": "auth != null && (auth.uid == $roomId || auth.token.role == 'teacher' || auth.token.role == 'admin')"
      }
    },
    "system_control": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'admin' || auth.token.role == 'ADMIN')"
    },
    "active_class_session": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'teacher' || auth.token.role == 'TEACHER' || auth.token.role == 'admin' || auth.token.role == 'ADMIN')"
    },
    "audit_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },
    "sessions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },
    "replays": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "approved_tasks": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'teacher' || auth.token.role == 'TEACHER' || auth.token.role == 'admin' || auth.token.role == 'ADMIN')"
    },
    "ai_pending_approvals": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "reflections": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    }
  }
}
