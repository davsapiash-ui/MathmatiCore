# Loaded only when Vitest runs (mode "test"); never by `npm run dev` or `npm run build`.
# Tests use a `demo-` project that does not exist, never the live mathimaticore project.
# See src/test/noProductionNetwork.ts.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mathmaticore.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-mathmaticore
VITE_FIREBASE_PROJECT_ID=demo-mathmaticore
VITE_FIREBASE_STORAGE_BUCKET=demo-mathmaticore.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MEASUREMENT_ID=G-DEMO
