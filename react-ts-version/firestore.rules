rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check teacher claim (STRICT: no email != null fallback)
    function isTeacher() {
      return isAuthenticated() && (request.auth.token.role == 'teacher' || request.auth.token.role == 'TEACHER' || request.auth.token.teacher == true);
    }
    
    // Helper function to check admin claim
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.role == 'ADMIN' || request.auth.token.admin == true);
    }

    // Helper function to check if authenticated as specific student (Verified Custom Claim strictly)
    function isOwningStudent(studentId) {
      return isAuthenticated() && (
        request.auth.token.student_id != null && 
        (request.auth.token.student_id == studentId || string(request.auth.token.student_id) == studentId)
      );
    }

    // Teacher class match check
    function isTeacherOfClass(classId) {
      return isTeacher() && (
        request.auth.token.class_id == null || 
        request.auth.token.class_id == classId || 
        isAdmin()
      );
    }

    // --- Strict Allowlist Schemas (Replacing Negative PII Blocklists) ---

    // 1. Anonymous Student Schema Allowlist (Module 4 & Appendix A §1)
    function isValidStudentDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'student_id',
        'class_id',
        'school_id',
        'created_at',
        'support_profile_id',
        'support_profile_version',
        'support_profile_updated_at',
        'support_profile_updated_by',
        'active_session_id'
      ]) &&
      data.student_id is int && data.student_id >= 1 && data.student_id <= 12 &&
      data.class_id is string &&
      data.school_id is string &&
      data.created_at is number &&
      data.support_profile_version is int;
    }

    // 2. Telemetry Log Schema Allowlist (Module 5 & Appendix A §3)
    function isValidTelemetryEvent() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'idempotency_key',
        'timestamp',
        'server_timestamp',
        'session_id',
        'student_id',
        'event_type',
        'payload'
      ]) &&
      data.idempotency_key is string &&
      data.timestamp is number &&
      data.session_id is string &&
      data.student_id is int && data.student_id >= 1 && data.student_id <= 12 &&
      data.event_type is string &&
      data.payload is map;
    }

    // 3. Session Progress Schema Allowlist (Module 7 & Appendix A §2)
    function isValidSessionDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'session_id',
        'class_id',
        'session_number',
        'is_completed',
        'session_score_percent',
        'matrix_recommended_path',
        'teacher_selected_path',
        'teacher_gate_approved',
        'gate_approved_at',
        'gate_approved_by',
        'active_exercise_id',
        'session_start_time',
        'session_deadline_time',
        'completed_at',
        'evaluated_at'
      ]) &&
      data.session_id is string &&
      data.session_number is int && data.session_number >= 1 && data.session_number <= 8 &&
      data.is_completed is bool &&
      data.teacher_gate_approved is bool;
    }

    // 4. Support Ticket Schema Allowlist (Module 18 & Appendix A §4)
    function isValidSupportTicket() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'ticket_id',
        'category',
        'severity',
        'subject',
        'description',
        'status',
        'created_at',
        'created_by',
        'assigned_to',
        'school_id',
        'class_id',
        'system_info',
        'source_conversation_id',
        'updated_at',
        'resolved_at',
        'resolution_notes'
      ]) &&
      data.ticket_id is string &&
      data.category is string &&
      data.severity is string &&
      data.status is string &&
      data.created_at is number &&
      data.created_by is string;
    }

    // 5. SRL Reflection Schema Allowlist (Module 10 & Appendix A §5)
    function isValidSRLReflection() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'student_id',
        'session_id',
        'session_number',
        'effort_level',
        'focus_area',
        'persistence_index',
        'undo_count',
        'error_count',
        'guess_count',
        'submitted_at'
      ]) &&
      data.student_id is int && data.student_id >= 1 && data.student_id <= 12 &&
      data.session_id is string &&
      data.session_number is int &&
      data.effort_level is string &&
      data.persistence_index is number &&
      data.submitted_at is number;
    }

    // 6. Chat Message Schema Allowlist (Module 22 & Appendix A §6)
    function isValidChatMessageDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'conversation_id',
        'sender_id',
        'sender_role',
        'recipient_id',
        'recipient_role',
        'content',
        'timestamp',
        'read_by_recipient',
        'support_ticket_id',
        'delivery_status'
      ]) &&
      data.conversation_id is string &&
      data.sender_id is string &&
      data.sender_role is string &&
      data.recipient_id is string &&
      data.recipient_role is string &&
      data.content is string &&
      data.timestamp is number &&
      data.read_by_recipient is bool;
    }

    // --- COLLECTION RULES ---

    // 1. Students Collection (/students/{studentId})
    match /students/{studentId} {
      allow read: if isTeacher() || isOwningStudent(studentId);
      allow create: if (isOwningStudent(studentId) || isTeacher()) && isValidStudentDoc();
      allow update: if (isOwningStudent(studentId) || isTeacher()) && isValidStudentDoc();
      allow delete: if isAdmin() || isTeacher();
    }

    // 2. Telemetry Logs Collection (/telemetry_logs/{logId})
    match /telemetry_logs/{logId} {
      allow read: if isTeacher();
      allow create: if isAuthenticated() && 
                      isOwningStudent(request.resource.data.student_id) && 
                      isValidTelemetryEvent();
      allow update: if false; // Append-only immutable log
      allow delete: if false; // Immutable audit log
    }

    // 3. Sessions Collection (/sessions/{sessionId})
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidSessionDoc();
      allow update: if isAuthenticated() && isValidSessionDoc() && (
        // Student cannot self-approve gate
        (isTeacher() || isAdmin()) ||
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacher_gate_approved', 'teacher_selected_path']))
      );
      allow delete: if isAdmin();
    }

    // 4. Messages Collection (/messages/{messageId})
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() || 
        request.auth.uid == resource.data.sender_id || 
        request.auth.uid == resource.data.recipient_id ||
        (request.auth.token.role == 'student' && (
          string(request.auth.token.student_id) == resource.data.sender_id || 
          string(request.auth.token.student_id) == resource.data.recipient_id
        ))
      );
      allow create: if false; // Only Cloud Functions write messages directly to Firestore
      allow update: if isAuthenticated() && (
        // Allow recipient to mark message as read
        (request.auth.uid == resource.data.recipient_id || 
         string(request.auth.token.student_id) == resource.data.recipient_id ||
         isTeacher() || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by_recipient'])
      );
      allow delete: if isAdmin();
    }

    // 5. Support Tickets Collection (/support_tickets/{ticketId})
    match /support_tickets/{ticketId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if (isTeacher() || isAdmin()) && isValidSupportTicket();
      allow update: if (isTeacher() || isAdmin()) && isValidSupportTicket();
      allow delete: if isAdmin();
    }

    // 6. SRL Reflections Collection (/srl_reflections/{reflectionId})
    match /srl_reflections/{reflectionId} {
      allow read: if isTeacher() || (isAuthenticated() && isOwningStudent(resource.data.student_id));
      allow create: if isAuthenticated() && isOwningStudent(request.resource.data.student_id) && isValidSRLReflection();
      allow update: if false; // Immutable student reflection
      allow delete: if isAdmin();
    }

    // 7. System Control Collection (/system_control/{controlId})
    match /system_control/{controlId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. Replays Collection (/replays/{replayId})
    match /replays/{replayId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isTeacher() || isAdmin();
    }
  }
}
