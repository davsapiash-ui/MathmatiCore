# Firebase web-app config — copy to .env.local and fill from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
# .env.local is gitignored; never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mathimaticore.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://mathimaticore-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=mathimaticore
VITE_FIREBASE_APP_ID=

# Allowed Institutional Domains for Teacher & Admin Google SSO (comma-separated)
VITE_ALLOWED_DOMAINS=edu-haifa.org.il,education.gov.il,g.education.gov.il,schools.org.il,edu.gov.il

# Specific Whitelisted Emails (comma-separated, optional)
VITE_ALLOWED_EMAILS=
