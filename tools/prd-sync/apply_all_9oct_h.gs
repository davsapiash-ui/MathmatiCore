  [" גלו את הספרה בעזרת הלבנים וכתבו אותה בתיבה הריקה.\" | שלוש", " גלו את הספרה בעזרת הלבנים. כתבו אותה בתיבה הריקה.\" | שלוש"],
  [" הראשון. גלו אותן בעזרת הלבנים וכתבו אותן בתיבות הריקות. רוצים לחזור צעד", " הראשון. גלו אותן בעזרת הלבנים. כתבו אותן בתיבות הריקות. רוצים לחזור צעד"],
  [" שונים. גלו אותן בעזרת הלבנים וכתבו אותן בתיבות הריקות.\" |", " שונים. גלו אותן בעזרת הלבנים. כתבו אותן בתיבות הריקות.\" |"],
  [" גלו את הספרות בעזרת הלבנים וכתבו אותן בתיבות הריקות.\" |", " גלו את הספרות בעזרת הלבנים. כתבו אותן בתיבות הריקות.\" |"],
  [" הראשון. גלו אותן בעזרת הלבנים וכתבו אותן בתיבות הריקות.\" | איתור", " הראשון. גלו אותן בעזרת הלבנים. כתבו אותן בתיבות הריקות.\" | איתור"],
  [" העשרות במספר הראשון. גלו אותה וכתבו אותה בתיבה הריקה.\" | בעיית", " העשרות במספר הראשון. גלו אותה. כתבו אותה בתיבה הריקה.\" | בעיית"],
  [" שתי ספרות במספר הראשון. גלו אותן וכתבו אותן בתיבות הריקות.\" |", " שתי ספרות במספר הראשון. גלו אותן. כתבו אותן בתיבות הריקות.\" |"],
  [" שלוש ספרות במספר הראשון. גלו אותן וכתבו אותן בתיבות הריקות.\" |", " שלוש ספרות במספר הראשון. גלו אותן. כתבו אותן בתיבות הריקות.\" |"],
  [" משתנה\". שורת המטרה: \"משימת היעד: איזה מספר, לדעתכם, מייצגות הלבנים לאחר הפריטה?\" הצעדים הם שלושת", " משתנה\". שורת המטרה: \"משימת היעד: לדעתכם, איזה מספר יהיה בבית המספרים לאחר הפריטה?\" הצעדים הם שלושת"],
  [" לעשר לבני יחידה.\", \"כתבו בשורת התוצאה איזה מספר מייצגות הלבנים עכשיו.\". הסעיף השלישי", " לעשר לבני יחידה.\", \"כתבו בשורת התוצאה איזה מספר הלבנים מראות עכשיו.\". הסעיף השלישי"],
  [" הנושא \"פורטים לבנים\"; מטרה \"איזה מספר מייצגות הלבנים לאחר הפריטה?\"; צעדים \"1.", " הנושא \"פורטים לבנים\"; מטרה \"איזה מספר הלבנים מראות לאחר הפריטה?\"; צעדים \"1."],
  [" מאה ו-13 לבני עשרת. בכל טור שיש בו 10 לבנים או יותר, לחצו על הכפתור \"קבצו 10\" שבראש הטור. איזה מספר מייצגות הלבנים עכשיו? כתבו אותו בשורת", " מאה ו-13 לבני עשרת. קבצו בכל טור שיש בו 10 לבנים או יותר. לחצו על הכפתור \"קבצו 10\" שבראש הטור. איזה מספר הלבנים מראות עכשיו? כתבו אותו בשורת"],
  [" המספר בדרך אחת. לחצו על הכפתור \"הוספת ייצוג\". אחר כך בנו אותו בדרך שונה, ולחצו שוב על \"הוספת ייצוג\". רוצים לחזור צעד", " המספר בדרך אחת. לחצו על הכפתור \"שמירת הדרך\". אחר כך בנו אותו בדרך שונה. לחצו שוב על \"שמירת הדרך\". רוצים לחזור צעד"],
  [" של הרכבים משתנים: \"מצאו שתי דרכים שונות לייצג את המספר 150 כך שבכל דרך יש לבני עשרת, ומספר לבני העשרת זוגי.\" (שני ייצוגים שונים,", " של הרכבים משתנים: \"מצאו שתי דרכים שונות לבנות את המספר 150. בכל דרך יהיו לבני עשרת, ומספר לבני העשרת יהיה זוגי.\" (שני ייצוגים שונים,"],
  [" ללבנת אלף אחת?\". בתרגיל הגמישות השאלה היא \"נסו לחשוב: איך מוצאים דרך נוספת לייצג את המספר N?\". במצבים מיוחדים", " ללבנת אלף אחת?\". בתרגיל הגמישות השאלה היא \"נסו לחשוב: איך מוצאים דרך נוספת לבנות את המספר N?\". במצבים מיוחדים"],
  [" 2,183 = 5,639; \"מחליפים רק את ספרת היחידות של המחובר הראשון: 3,459 + 2,183. מה ישתנה?\" התשובה הנכונה: תיווסף המרה גם בטור היחידות, ההמרה בטור העשרות תישאר, והתוצאה תהיה 5,642 |", " 2,183 = 5,639; \"מחליפים רק את ספרת היחידות במספר הראשון: 3,459 + 2,183. מה ישתנה?\" התשובה הנכונה: \"תהיה הקבצה בטור היחידות ובטור העשרות, והתוצאה תהיה 5,642\"; שתי התשובות האחרות בנויות כמוה: \"תהיה הקבצה רק בטור העשרות, והתוצאה תהיה 5,632\" ו\"תהיה הקבצה רק בטור היחידות, והתוצאה תהיה 5,542\" |"],
  [" 3,381 = 4,270; \"מחליפים רק את ספרת העשרות של המחוסר: 7,691 − 3,381. מה ישתנה?\" התשובה הנכונה: לא תידרש יותר פריטה כי 9 עשרות גדולות מ-8 עשרות, והתוצאה תהיה 4,310 |", " 3,381 = 4,270; \"מחליפים רק את ספרת העשרות במספר הראשון: 7,691 − 3,381. מה ישתנה?\" התשובה הנכונה: \"לא תהיה פריטה באף טור, והתוצאה תהיה 4,310\"; שתי התשובות האחרות בנויות כמוה: \"תהיה פריטה מטור המאות, והתוצאה תהיה 4,210\" ו\"לא תהיה פריטה באף טור, והתוצאה תישאר 4,270\" |"],
  [" של הלומדים: ההנחיה \"השוו בין שני תרגילים קרובים וגלו כיצד המרה בטור העשרות משפיעה על הטורים הבאים.\", התרגיל הפתור", " של הלומדים: ההנחיה \"השוו בין שני תרגילים קרובים: איך הקבצה בטור העשרות משפיעה על הטורים הבאים?\", התרגיל הפתור"],
  [" = 384, השאלה \"מחליפים רק את ספרת העשרות של המחובר השני: 238 + 186. מה ישתנה?\" ושלוש התשובות \"תיווסף", " = 384, השאלה \"מחליפים רק את ספרת העשרות במספר השני: 238 + 186. מה ישתנה?\" ושלוש התשובות \"תיווסף"],
  [" ישתנה?\" ושלוש התשובות \"תיווסף המרה גם בטור העשרות, ההמרה בטור היחידות תישאר, והתוצאה תהיה 424\" (הנכונה: 238 + 186 = 424, הקבצה ביחידות ובעשרות), \"רק ספרת העשרות בתוצאה תשתנה, והתוצאה תהיה 324\" ו\"ההמרה בטור היחידות תיעלם, והתוצאה תהיה 414\"; המורה בוחרת", " ישתנה?\" ושלוש התשובות \"תהיה הקבצה בטור היחידות ובטור העשרות, והתוצאה תהיה 424\" (הנכונה: 238 + 186 = 424, הקבצה ביחידות ובעשרות), \"תהיה הקבצה רק בטור היחידות, והתוצאה תהיה 324\" ו\"תהיה הקבצה רק בטור העשרות, והתוצאה תהיה 414\"; המורה בוחרת"],
  [" הודעת \"נכון!\": \"נכון! במספר שבע מאות ושלוש אין עשרות, ולכן בטור העשרות כותבים 0: 703.\"", " הודעת \"נכון!\": \"נכון! במספר שבע מאות ושלוש אין לבנים בטור העשרות, ולכן כותבים שם 0: 703.\""],
  [" \"ברוכים הבאים למתמטיקאור! בתחנה הראשונה מכירים את הכלים: שחקו וחקרו בחופשיות.\" צעד אחד,", " \"ברוכים הבאים למתמטיקאור! בתחנה הראשונה מכירים את הכלים. שחקו וחקרו בחופשיות.\" צעד אחד,"],
  [" בלי מספר: \"גררו 5 לבנים לטורים משמאל, וצפו בספרות המשתנות בבית המספרים.\", המסומן אחרי", " בלי מספר: \"גררו 5 לבנים לטורים משמאל. צפו בספרות המשתנות בבית המספרים.\", המסומן אחרי"],
  [" יחידה.\" הצעדים: \"1. קבצו כל 10 לבני יחידה ללבנת עשרת אחת: לחצו על הכפתור \"קבצו 10\" שבראש הטור.\" (אינו מסומן;", " יחידה.\" הצעדים: \"1. קבצו כל 10 לבני יחידה ללבנת עשרת אחת. לחצו על הכפתור \"קבצו 10\" שבראש הטור.\" (אינו מסומן;"],
  [" על ידי המנוע, הספרה שעוברת לטור הבא אינה נקראת \"שארית\": בחיבור היא \"המרה\" ובחיסור \"פריטה\", והיא נרשמת בעיגול הזיכרון. כרטיס \"המחובר החסר\" שואל \"כיצד מוצאים מחובר חסר?\" ומשיב \"מהסכום מחסרים את המחובר הידוע, ומקבלים את המחובר החסר\". כרטיס \"המספר שחיסרנו\"", " על ידי המנוע, הספרה שעוברת לטור הבא אינה נקראת \"שארית\": בחיבור היא באה מ\"הקבצה\" ובחיסור מ\"פריטה\", והיא נרשמת בעיגול הזיכרון. כרטיס \"המספר החסר בחיבור\" שואל \"איך מוצאים את המספר החסר בתרגיל חיבור?\" ומשיב \"מהתוצאה מחסרים את המספר הידוע, ומקבלים את המספר החסר\". כרטיס \"המספר שחיסרנו\""],
  [" והאפשרות הנכונה היא \"בונים בבית המספרים את מה שההנחיה מבקשת\". בקריאת מספר", " והאפשרות הנכונה היא \"בונים בבית המספרים את מה שההוראה מבקשת\". בקריאת מספר"],
  [" קודם?\" (התשובה הנכונה: \"בונים בבית המספרים את מה שההנחיה מבקשת\"); בתחנה 3,", " קודם?\" (התשובה הנכונה: \"בונים בבית המספרים את מה שההוראה מבקשת\"); בתחנה 3,"],
  [" מקבל את השאלה \"נסו לחשוב: באילו לבנים ההנחיה מבקשת לבנות את המספר N?\". בכרטיס הזה", " מקבל את השאלה \"נסו לחשוב: באילו לבנים ההוראה מבקשת לבנות את המספר N?\". בכרטיס הזה"],
  [" ההנחיה מבקשת (\"רמז: גם זה N. באילו לבנים ההנחיה מבקשת לבנות אותו?\" או \"רמז: גם", " ההנחיה מבקשת (\"רמז: גם זה N. באילו לבנים ההוראה מבקשת לבנות אותו?\" או \"רמז: גם"],
  [" לבנות אותו?\" או \"רמז: גם זה N. האם ההנחיה מבקשת לבנות אותו רק מלבני יחידה?\"). כשההנחיה מבקשת", " לבנות אותו?\" או \"רמז: גם זה N. האם ההוראה מבקשת לבנות אותו רק מלבני יחידה?\"). כשההנחיה מבקשת"],
  ["ייצוג מספר בדרכים שונות — \"מייצגים מספר בדרכים שונות\"", "ייצוג מספר בדרכים שונות — \"בונים מספר בדרכים שונות\""],
  ["\"3. כתבו בשורת התוצאה איזה מספר מייצגות הלבנים עכשיו.\" (מסומן כשהתיבות", "\"3. כתבו בשורת התוצאה איזה מספר הלבנים מראות עכשיו.\" (מסומן כשהתיבות"],
  ["ו\"רשמו את ההמרה בעיגול הזיכרון.\", \"2. כתבו", "ו\"אחר כך רשמו בעיגול הזיכרון את ה־1 שעבר לטור הבא.\", \"2. כתבו"],
  ["\"2. הוציאו מבית המספרים את הכמות הנדרשת.\" (אינו מסומן)", "\"2. הוציאו מבית המספרים את המספר השני, [המספר השני].\" (אינו מסומן)"],
  ["הקישורים להורדתם בתוקף לשעה אחת מרגע יצירתם, כמו הקישור לדוח הלומד;", "הקישורים להורדתם נוצרים בכל בקשה של מורה מחוברת, כמו הקישור לדוח הלומד;"]
] },
  { name: "מסמך 02", id: '1r74zTVq-C1Xa8WrYwOdUMvlhd3OEVty4o2K207rJhgI', version: null, edits: [
  ["פריטה דרך אפס בתרגיל 500 פחות 234.", "חיסור עם שתי פריטות, כשבמחוסר יש אפסים, בתרגיל 700 פחות 234."],
  ["ביצוע פריטה כפולה או משולשת סימולטנית דרך טור העשרות הריק. מודל", "ביצוע שתי פריטות או שלוש פריטות רצופות, כשבמחוסר יש אפסים. מודל"],
  ["ביצוע פריטה כפולה או משולשת סימולטנית דרך טור העשרות הריק בתרגילי חיסור במאונך.", "ביצוע שתי פריטות או שלוש פריטות רצופות בתרגילי חיסור במאונך, כשבמחוסר יש אפסים."],
  ["המצריכים פריטה כפולה או משולשת דרך ספרת האפס.", "המצריכים שתי פריטות או שלוש פריטות, כשבמחוסר יש אפסים."],
  [" \"כאשר מצטברות 10 לבנים בטור, לחצו על הכפתור \"קבצו 10\" שבראש הטור ורשמו את ההמרה בעיגול הזיכרון.\"", " \"כשמצטברות 10 לבנים בטור, לחצו על הכפתור \"קבצו 10\" שבראש הטור. אחר כך רשמו בעיגול הזיכרון את ה־1 שעבר לטור הבא.\""],
  ["\"בנו את המחוסר בבית המספרים.\"", "\"בנו בבית המספרים את המספר הראשון.\"", null, 1, 2],
  ["\"בנו את המחוסר בבית המספרים.\"", "\"בנו בבית המספרים את המספר הראשון.\"", null, 1, 1],
  ["\"אם בטור אין מספיק לבנים, אפשר לפרוט לבנה מהטור שמשמאלו: לחצו עליה או גררו אותה אל אותו טור.\"", "\"אם בטור אין מספיק לבנים, אפשר לפרוט לבנה מהטור שמשמאלו. לחצו על הלבנה, או גררו אותה אל הטור שמימין.\"", null, 1, 2],
  ["\"אם בטור אין מספיק לבנים, אפשר לפרוט לבנה מהטור שמשמאלו: לחצו עליה או גררו אותה אל אותו טור.\"", "\"אם בטור אין מספיק לבנים, אפשר לפרוט לבנה מהטור שמשמאלו. לחצו על הלבנה, או גררו אותה אל הטור שמימין.\"", null, 1, 1],
  ["\"הוציאו מבית המספרים את הכמות הנדרשת וכתבו את התוצאה בשורת התוצאה.\"", "\"הוציאו מבית המספרים את המספר השני. כתבו את התוצאה בשורת התוצאה.\"", null, 1, 2],
  ["\"הוציאו מבית המספרים את הכמות הנדרשת וכתבו את התוצאה בשורת התוצאה.\"", "\"הוציאו מבית המספרים את המספר השני. כתבו את התוצאה בשורת התוצאה.\"", null, 1, 1]
